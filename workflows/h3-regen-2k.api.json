{
  "1": {
    "class_type": "LoadVideo",
    "inputs": {
      "file": "draft.mp4"
    },
    "_meta": {
      "title": "Load Video (H3 draft)"
    }
  },
  "2": {
    "class_type": "GetVideoComponents",
    "inputs": {
      "video": [
        "1",
        0
      ]
    },
    "_meta": {
      "title": "Frames of the draft"
    }
  },
  "3": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "minimax_h3_video_vae_int8_convrot.safetensors"
    },
    "_meta": {
      "title": "H3 video VAE"
    }
  },
  "4": {
    "class_type": "VAEEncode",
    "inputs": {
      "pixels": [
        "2",
        0
      ],
      "vae": [
        "3",
        0
      ]
    },
