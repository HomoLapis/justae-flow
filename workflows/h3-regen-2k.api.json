        "14",
        0
      ],
      "sampler": [
        "15",
        0
      ],
      "sigmas": [
        "16",
        0
      ],
      "latent_image": [
        "13",
        0
      ]
    },
    "_meta": {
      "title": "Refine (3 steps)"
    }
  },
  "19": {
    "class_type": "LTXVSeparateAVLatent",
    "inputs": {
      "av_latent": [
        "18",
        0
      ]
    },
    "_meta": {
      "title": "Separate audio/video latent"
    }
  },
  "20": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": [
        "19",
        0
      ],
      "vae": [
        "3",
        0
      ]
    },
    "_meta": {
      "title": "Decode"
    }
  },
  "21": {
    "class_type": "CreateVideo",
    "inputs": {
      "images": [
        "20",
        0
      ],
