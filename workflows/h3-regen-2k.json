{
  "id": "h3-regen-2k",
  "title": "Open-H3 · Regenerate to 2K",
  "description": "An H3 draft (768p, 24 fps) rebuilt at twice its size by the H3 model itself with the Open-H3 refiner LoRA: motion and timing stay, textures are redrawn, the sound is made again. Three steps over the LBH latent upscale.",
  "task": "upscale-video",
  "hosts": [
    "effectcraft"
  ],
  "output": "video",
  "input": "video",
  "bindings": {
    "video": "1.file",
    "prompt": "10.value",
    "seed": "17.noise_seed"
  },
  "params": [
    {
      "ref": "5.mode.width",
      "label": "Target width"
    },
    {
      "ref": "5.mode.height",
      "label": "Target height"
    },
    {
      "ref": "11.width",
      "label": "Canvas width"
    },
    {
      "ref": "11.height",
      "label": "Canvas height"
    },
    {
      "ref": "11.length",
      "label": "Frames"
    }
  ],
  "frameLattice": {
    "min": 5,
    "step": 17
  },
  "sizeMultiple": 32,
  "license": {
    "weights": "MiniMax H3 open weights (commercial use of locally generated outputs needs a MiniMax commercial licence, sold by Comfy; EU: to be verified); Open-H3 refiner LoRA: NVlabs, no licence stated on its page, merges LightX2V Turbo and LMS Sharp; LBH latent upscaler: its own licence",
    "openWeights": true
  },
  "api": "h3-regen-2k.api.json",
  "models": [
    {
      "name": "minimax_h3_fl2va_pruned_int8_convrot.safetensors",
      "directory": "diffusion_models",
      "url": "https://huggingface.co/Comfy-Org/MiniMax-H3/resolve/main/diffusion_models/minimax_h3_fl2va_pruned_int8_convrot.safetensors"
    },
    {
      "name": "qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors",
      "directory": "text_encoders",
      "url": "https://huggingface.co/Comfy-Org/MiniMax-H3/resolve/main/text_encoders/qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors"
    },
    {
      "name": "minimax_h3_video_vae_int8_convrot.safetensors",
      "directory": "vae",
      "url": "https://huggingface.co/Comfy-Org/MiniMax-H3/resolve/main/vae/minimax_h3_video_vae_int8_convrot.safetensors"
    },
    {
      "name": "minimax_h3_open_regenerate_2k_r128_comfyui_bf16.safetensors",
      "directory": "loras",
      "url": "https://huggingface.co/father558/H3-Open-Regenerate-2K-ComfyUI-r128/resolve/main/minimax_h3_open_regenerate_2k_r128_comfyui_bf16.safetensors"
    },
    {
      "name": "minimax_h3_latent_upscaler_3d_conv_v1_fp16.safetensors",
      "directory": "latent_upscale_models",
      "url": "https://huggingface.co/LBH-123-AI/Minimax_h3_latent_Upscaler/resolve/main/minimax_h3_latent_upscaler_3d_conv_v1/minimax_h3_latent_upscaler_3d_conv_v1_fp16.safetensors"
    }
  ],
  "source": {
