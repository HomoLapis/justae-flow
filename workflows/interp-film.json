{
  "id": "interp-film",
  "title": "FILM · Frame interpolation (ComfyUI core)",
  "description": "The official template as it ships: core nodes and Google's FILM model, for large motion RIFE tears on.",
  "task": "interpolate-video",
  "hosts": [
    "effectcraft"
  ],
  "output": "video",
  "input": "video",
  "bindings": {
    "video": "4.file"
  },
  "params": [
    {
      "ref": "16:9.value",
      "label": "Multiplier"
    },
    {
      "ref": "16:13.value",
      "label": "Multiply the frame rate"
    }
  ],
  "interpolate": {
    "multiplier": "16:9.value",
    "multiplyFps": "16:13.value",
    "audio": "16:5.audio"
  },
  "license": {
    "weights": "Apache-2.0 (FILM, google-research/frame-interpolation); the file is Comfy-Org's repackaging (its model card says \"other\": DA VERIFICARE)",
    "openWeights": true
  },
  "api": "interp-film.api.json",
  "models": [
    {
      "name": "film_net_fp16.safetensors",
      "directory": "frame_interpolation",
      "url": "https://huggingface.co/Comfy-Org/frame_interpolation/resolve/main/frame_interpolation/film_net_fp16.safetensors"
    }
  ],
  "source": {
    "template": "utility_video_frame_interpolation",
    "package": "comfyui-workflow-templates",
    "version": "0.11.76"
  }
}
