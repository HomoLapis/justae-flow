# Copy to .env (never committed) to override the settings saved by the app.
# Everything here can also be set from the app's Settings panel.

# Your ComfyUI — local, on your network, or behind comfy-api-proxy.
COMFY_URL=http://127.0.0.1:8188

# EffectCraft's control channel port (start EffectCraft with --control <port>).
EFFECTCRAFT_CONTROL_PORT=9877

# Port of the Shiftfield UI (http://127.0.0.1:<port>).
SHIFTFIELD_PORT=5199
