# Copy to .env (never committed) to override the settings saved by the app.
# Everything here can also be set from the app's Settings panel.

# Your ComfyUI — local, on your network, or in your own cloud behind a router.
COMFY_URL=http://127.0.0.1:8188

# Only for a ComfyUI behind an authenticating router: its bearer token, and the
# router's GPU key for jobs (empty = the router's default).
COMFY_TOKEN=
COMFY_GPU=

# Which app JustAE Flow drives: effectcraft or photocraft.
JUSTAE_FLOW_HOST=effectcraft

# EffectCraft's control channel port (start EffectCraft with --control <port>).
EFFECTCRAFT_CONTROL_PORT=9877

# PhotoCraft: control port, the token file it creates, and its automation folder
# (start PhotoCraft with --control, --control-token-file and --automation-read/write-root).
PHOTOCRAFT_CONTROL_PORT=7878
PHOTOCRAFT_CONTROL_TOKEN_FILE=
PHOTOCRAFT_AUTOMATION_ROOT=

# Port of the JustAE Flow UI (http://127.0.0.1:<port>).
JUSTAE_FLOW_PORT=5199

# Comfy's platform API key (Comfy Cloud and your Comfy API deployments), for a setup without the UI.
# Settings ▸ Resources keeps it in comfy-api-key.txt in your user folder instead; that file wins.
COMFY_API_KEY=
